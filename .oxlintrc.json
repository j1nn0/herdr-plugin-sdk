{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "warn"
  },
  "rules": {
    "max-classes-per-file": "off"
  },
  "overrides": [
    {
      "files": ["tests/**"],
      "rules": {
        "max-lines-per-function": "off"
      }
    }
  ]
}
